// The schema. docs/DATA-MODEL.md is the source of truth — this file
// implements what that document says, module by module, in the order
// docs/stages/ locks them. Models land here only as each stage doc is
// actually implemented; nothing here should ever be ahead of a locked
// stage doc. If this file and DATA-MODEL.md ever disagree, that's a bug
// — see CLAUDE.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Module 1 (Auth & Email) — see docs/stages/01-auth-and-email-setup.md.
model User {
  id           String  @id @default(uuid())
  email        String  @unique
  passwordHash String
  displayName  String

  emailVerifiedAt DateTime?

  // Single outstanding email-verification token, hashed (see D54,
  // docs/DECISIONS.md) — not cleared on successful verification.
  // emailVerifiedAt is what gates single-use behavior; keeping the hash
  // around lets a repeat hit on the same verify link resolve to this
  // user and be recognized as an idempotent no-op instead of "invalid
  // token". Overwritten (invalidating the previous token) on signup
  // and on every resend.
  verificationTokenHash      String?   @unique
  verificationTokenExpiresAt DateTime?

  // bannedByUserId (audit: who issued the ban) is deferred — no
  // ban-issuing endpoint exists yet; these two fields only support the
  // signup-time rejection check this stage's doc requires.
  bannedAt     DateTime?
  bannedReason String?

  // Module 2 (Roles & Membership) — see
  // docs/stages/02-roles-and-membership.md Section 2. Set once, at
  // creation, by whichever code path creates the account (self-signup
  // always PARTICIPANT; admin-created staff accounts choose JUDGE or
  // ORGANIZER) — never edited afterward, by design. No Prisma-level
  // default: every creation path must be explicit about what it's
  // creating, rather than silently relying on an implicit default.
  accountType AccountType

  // True for admin-created staff accounts until their first
  // /auth/set-password call. Never true for self-signed-up participants.
  mustResetPassword Boolean @default(false)

  // Platform-operator flag, orthogonal to accountType. Provisioned only
  // outside normal app flow (scripts/bootstrap-admin.ts) — there is no
  // in-app "create a site admin" action.
  siteAdmin Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]

  memberships     EventMembership[] @relation("MemberUser")
  sentInvitations EventMembership[] @relation("InvitingUser")
  auditLogEntries  AuditLog[]

  adminOfTeams    Team[]           @relation("TeamAdmin")
  teamMemberships TeamMembership[]
  soloSubmissions Submission[]

  // Module 6 — organizer/admin who resolved a verification's
  // finalDecision. Nullable on the other side (most SubmissionVerification
  // rows are never manually reviewed at all, e.g. auto-VERIFIED ones).
  verificationReviews SubmissionVerification[] @relation("VerificationReviewer")

  // Module 7 — projects this user, as a judge, has been assigned to.
  judgeAssignments JudgeAssignment[] @relation("AssignmentJudge")

  // Reliability notes about this user (as the judge the incident is
  // about) vs. notes this user has authored (as the organizer/admin who
  // wrote one about someone else) are two entirely different relations
  // on the same table — Section 5, docs/stages/07-judge-assignment.md.
  reliabilityNotesAbout    JudgeReliabilityNote[] @relation("ReliabilityNoteSubject")
  reliabilityNotesAuthored JudgeReliabilityNote[] @relation("ReliabilityNoteAuthor")
}

model Session {
  id        String  @id @default(uuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String  @unique

  userAgent String?
  ipHash    String?

  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

enum AccountType {
  PARTICIPANT
  JUDGE
  ORGANIZER
}

// Module 2 introduced this as a deliberately minimal anchor (D59); this
// is now Module 3's (docs/stages/03-event-management.md) full shape,
// with maxTeamSize (Module 4, D75) and trackAttachmentMode (Module 5)
// added additively on top as each owning module landed.
//
// eventClosedAt is still deliberately NOT here: it's used only by
// voting-round-restart logic (not yet a locked stage doc) and isn't
// part of any currently-implemented module's own validation chain.
model Event {
  id   String @id @default(uuid())
  name String

  // Editable only while status = DRAFT (D17-equivalent, Section 3.2).
  // Auto-generated from name at creation (slugified), organizer can
  // override while still DRAFT — see D68 in docs/DECISIONS.md for why
  // this is inferred rather than stated outright.
  slug String @unique

  // Markdown source, never rendered HTML — sanitized identically on
  // every render (preview and production), see Section 6. Optional:
  // nothing in this stage's doc requires a description before publish.
  description String?

  posterUrl    String?
  thumbnailUrl String?

  status EventStatus @default(DRAFT)

  // Module 4's field (Team Management), not Module 3's — flagged as
  // not-yet-implemented in DATA-MODEL.md until now. Admin counts toward
  // the total: maxTeamSize 4 means 1 admin + up to 3 more members, not
  // 4 on top of the admin (Section 5, docs/stages/04-team-management.md).
  // Defaults to 4 if not set at creation — an inferred default, not
  // stated by either module's doc; see D75 in docs/DECISIONS.md.
  maxTeamSize Int @default(4)

  // Module 5's field (Submission Management) — drives which
  // track-selection UI the submission form shows (Section 4,
  // docs/stages/05-submission-management.md). Defaults to NONE: an
  // organizer who never configures tracks gets a form with no track
  // field at all, rather than a form that silently requires one.
  trackAttachmentMode TrackAttachmentMode @default(NONE)

  // Module 7's field (Judge Assignment) — event-wide default cap on how
  // many projects a single judge can be assigned, referenced by both
  // manual and algorithmic assignment (Section 3/4,
  // docs/stages/07-judge-assignment.md). A per-judge
  // EventMembership.projectLimitOverride can raise or lower this for one
  // judge. Defaults to 20 — an inferred default (not stated by the
  // doc), generous enough to rarely block a small event's first
  // assignment pass while still being a real, visible cap rather than
  // effectively unbounded; same "additive field, sensible default"
  // precedent as maxTeamSize (D75).
  maxProjectsPerJudge Int @default(20)

  // Timeline — all required at creation (Section 3.3's ordering chain
  // can't be validated against a partially-set timeline). UTC.
  registrationOpensAt    DateTime
  registrationClosesAt   DateTime
  eventStartsAt          DateTime
  submissionsOpenAt      DateTime
  submissionsCloseAt     DateTime
  eventEndsAt            DateTime
  resultsAnnounceAt      DateTime
  votingOpensAt          DateTime
  votingClosesAt         DateTime
  votingWinnerAnnounceAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships EventMembership[]
  tracks      Track[]
  prizes      Prize[]
  teams       Team[]
  submissions Submission[]

  judgeAssignments JudgeAssignment[]

  // Module 7 — context-only relation (the note itself is platform-wide
  // on the judge's User, not scoped by this relation — Section 5,
  // docs/stages/07-judge-assignment.md).
  judgeReliabilityNotes JudgeReliabilityNote[]
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  DELETED
}

enum TrackAttachmentMode {
  NONE
  SINGLE
  MULTIPLE
}

model Track {
  id     String @id @default(uuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prizes Prize[]

  // Unique per event, not globally (Section 5).
  @@unique([eventId, name])
}

enum PrizeDecidedBy {
  JUDGES
  PUBLIC_VOTE
}

model Prize {
  id      String @id @default(uuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  trackId String?
  track   Track?  @relation(fields: [trackId], references: [id], onDelete: SetNull)

  name       String
  rank       Int
  decidedBy  PrizeDecidedBy

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum EventRole {
  PARTICIPANT
  JUDGE
  ORGANIZER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

// The single table every authorization guard checks (Section 4,
// docs/stages/02-roles-and-membership.md) — no global role field is
// ever consulted for event-scoped actions. Folds judge-invitation
// lifecycle in directly rather than a separate JudgeInvitation table
// (Section 5) — there's no point in this relationship's life where two
// tables would represent it at different stages.
model EventMembership {
  id String @id @default(uuid())

  userId String
  user   User   @relation("MemberUser", fields: [userId], references: [id], onDelete: Cascade)

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  role EventRole

  // Judge track-scoping. Empty = all tracks. The field exists now per
  // Section 5; the mechanics of actually scoping a judge's assignment
  // by track are explicitly out of scope until judge assignment
  // (Module 7+) — see Section 1's "Explicitly not in this stage."
  trackIds String[] @default([])

  // Module 7 — per-judge override of Event.maxProjectsPerJudge, set
  // explicitly by an organizer when a manual assignment would otherwise
  // exceed the event-wide default (Section 3,
  // docs/stages/07-judge-assignment.md). null = use the event default.
  projectLimitOverride Int?

  // ACCEPTED immediately for organizer rows (D12, docs/DECISIONS.md) —
  // there's no consent step for an already-vetted organizer account.
  // Starts PENDING for judge rows. Only ACCEPTED rows grant any access,
  // anywhere — a PENDING row exists in this table but must behave
  // identically to no row at all for every guard check.
  invitationStatus InvitationStatus @default(PENDING)

  invitedByUserId String?
  invitedBy       User?   @relation("InvitingUser", fields: [invitedByUserId], references: [id])
  invitedAt       DateTime?
  respondedAt     DateTime?

  // Hashed, single-use, same pattern as every other token in this
  // project (Module 1's session/verification tokens). No stored expiry
  // snapshot for the token itself — deliberately resolved in
  // docs/stages/03-event-management.md Section 4: the invitation
  // deadline is always computed live as event.eventStartsAt, so an
  // organizer editing the event's start date after invitations go out
  // automatically moves the effective deadline for every still-PENDING
  // invitation.
  invitationTokenHash String? @unique

  createdAt DateTime @default(now())

  // One membership row per user per event — a user can't simultaneously
  // hold two roles (or two separate pending invitations) on the same
  // event.
  @@unique([userId, eventId])
}

// Module 4 (Team Management) — see docs/stages/04-team-management.md.
model Team {
  id      String @id @default(uuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Immutable once set (D21-equivalent, Section 3) — no rename under
  // any circumstance. Unique per event, not globally.
  name String

  // Fixed, non-transferable (Section 6) — no ownership-transfer
  // mechanism anywhere. The only way this relationship ends is the team
  // being deleted; there is no intermediate "team with no admin" state.
  adminUserId String
  admin       User   @relation("TeamAdmin", fields: [adminUserId], references: [id])

  // Join code is `${joinLinkPrefix}-${joinLinkSuffix}`, e.g.
  // "team-xmass-482913". joinLinkPrefix (slugified name alone, D76) is
  // derived once at creation and never changes, since name never
  // changes (Section 4.1). joinLinkSuffix is the actual rotating
  // credential (Section 4.2) — regeneration only ever touches this
  // field, invalidating the previous value immediately. The pair is
  // globally unique (not just per event) because /teams/join resolves
  // a team from the code alone, with no event in the URL.
  joinLinkPrefix String
  joinLinkSuffix String

  createdAt DateTime @default(now())

  members    TeamMembership[]
  submission Submission?

  @@unique([eventId, name])
  @@unique([joinLinkPrefix, joinLinkSuffix])
}

model TeamMembership {
  id     String @id @default(uuid())
  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  // A user can only be on one team per event — enforced at the
  // application layer by checking across all of an event's teams
  // (there's no direct eventId column here to index on), not by a DB
  // constraint on this table alone.
  @@unique([teamId, userId])
}

// Module 5 (Submission Management) — see
// docs/stages/05-submission-management.md. teamId/everSubmitted started
// as a deliberately minimal anchor in Module 4 (D75), since Module 4's
// roster lock (Section 6 there) needs `everSubmitted` to exist before
// this module's own create/submit/unsubmit logic does. Everything else
// below is this module's full shape.
model Submission {
  id      String @id @default(uuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  submissionType SubmissionType

  // Exactly one of teamId/soloUserId is set, never both, never neither
  // — enforced at the application layer (Section 3), not a DB
  // constraint, since Postgres has no native "exactly one of these two
  // columns is non-null" check short of a CHECK constraint this schema
  // doesn't use elsewhere.
  teamId String? @unique
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  soloUserId String?
  soloUser   User?   @relation(fields: [soloUserId], references: [id])

  // Everything below is optional at the row level — a draft can be an
  // empty shell (Section 5.1). `submit` is what enforces non-empty
  // required fields, not the schema.
  title        String?
  description  String?
  repoUrl      String?
  demoVideoUrl String?
  liveUrl      String?

  // Works for both SINGLE and MULTIPLE trackAttachmentMode with one
  // shape — SINGLE just constrains the array to length 1 at validation
  // time (Section 7).
  trackIds String[] @default([])

  // The only distinction between in-progress and finalized (Section 5)
  // — no separate draft table.
  isDraft Boolean @default(true)

  // Always the most recent submit action's timestamp, overwritten on
  // every resubmit (Section 5.3) — not preserved from the first submit.
  submittedAt DateTime?

  // Set true on first successful submit, never reset — Module 4's
  // roster lock (D26) keys off this, not isDraft, so it has to survive
  // any number of later unsubmit/resubmit cycles.
  everSubmitted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Module 6 — one verification record per submission, created lazily
  // (NOT_RUN default) rather than backfilled for every existing row.
  verification SubmissionVerification?

  // Module 7 — zero or more judges assigned once finalDecision =
  // APPROVED (Section 2, docs/stages/07-judge-assignment.md). The
  // normal case is several (the brief's own example is 3 reviews per
  // project), so this is a list, unlike verification's 1:1.
  judgeAssignments JudgeAssignment[]

  // NULLs are distinct under Postgres's default unique-index semantics,
  // so this only constrains actual (eventId, soloUserId) pairs — it
  // doesn't limit how many TEAM rows (soloUserId always null) an event
  // can have.
  @@unique([eventId, soloUserId])
}

enum SubmissionType {
  SOLO
  TEAM
}

// Module 6 (Submission Verification) — see
// docs/stages/06-submission-verification.md. One row per Submission,
// overwritten on re-run (D101) — this is the current state, not a
// history log; ScoreRevision-style immutable snapshots aren't needed
// here because nothing downstream depends on a specific past run the
// way judging depends on past score submissions.
model SubmissionVerification {
  id String @id @default(uuid())

  submissionId String     @unique
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  // What the automated check found (or NOT_RUN if it hasn't run yet).
  // Deliberately separate from finalDecision (Section 4) — VERIFIED is
  // the only value that auto-resolves finalDecision; every other value
  // requires an explicit human action (D93, D94).
  checkStatus CheckStatus @default(NOT_RUN)

  // What actually gates Module 7's judge assignment. Never set directly
  // by the automated check except the one VERIFIED -> APPROVED path.
  finalDecision FinalDecision @default(PENDING_REVIEW)

  firstCommitAt DateTime?
  lastCommitAt  DateTime?

  totalCommits    Int @default(0)
  commitsInWindow Int @default(0)

  // Full sha/timestamp/message/author detail for every commit outside
  // [eventStartsAt, submissionsCloseAt] (Section 3.4) — retained for the
  // manual-review UI, never discarded down to just a count.
  outsideWindowCommits Json @default("[]")

  // Mandatory (enforced at the application layer, not the schema —
  // same pattern as every other conditionally-required field in this
  // project) when finalDecision = DISQUALIFIED (D99). Optional for an
  // APPROVED override.
  finalDecisionRemarks String?

  reviewedByUserId String?
  reviewedBy       User?   @relation("VerificationReviewer", fields: [reviewedByUserId], references: [id])

  checkedAt  DateTime?
  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CheckStatus {
  NOT_RUN
  VERIFIED
  SUSPICIOUS
  REJECTED
  PRIVATE
  NON_GITHUB
  ERROR
}

enum FinalDecision {
  PENDING_REVIEW
  APPROVED
  DISQUALIFIED
}

// Module 6's one deliberate exception to "never store a reversible
// secret" (D96) — a GitHub PAT must be read back in plaintext to call
// the GitHub API, unlike every hashed, compare-only token elsewhere in
// this schema. Admin-managed only (Section 5); never surfaced to
// organizers.
model GithubToken {
  id String @id @default(uuid())

  // AES-256-GCM ciphertext (iv + authTag + ciphertext, see
  // apps/worker's crypto helper) — the encryption key itself lives only
  // in the GITHUB_TOKEN_KEY env var, sourced from a Docker secret, never
  // in this table.
  tokenEncrypted String

  // Admin-facing name, e.g. "Token A - org bot account" — tokens are
  // never identified to anyone by their value.
  label String

  // Flipped to false the moment a call using this token fails auth
  // (expired/revoked on GitHub's side) — excluded from rotation from
  // that point on and surfaced as an admin-dashboard alert (D97), never
  // a silent failure.
  isValid Boolean @default(true)

  // Read from GitHub's rate-limit response headers after every call.
  // Rotation picks whichever valid, non-revoked token currently has the
  // most headroom; a token past its rateLimitResetAt with 0 remaining is
  // skipped until that time passes.
  rateLimitRemaining Int?
  rateLimitResetAt   DateTime?

  lastUsedAt DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Module 7 (Judge Assignment) — see
// docs/stages/07-judge-assignment.md. Decides *who* reviews *what*, not
// scoring itself (Module 8). submissionId is intentionally not unique —
// a project normally has several judges (Section 3).
model JudgeAssignment {
  id String @id @default(uuid())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  judgeId String
  judge   User   @relation("AssignmentJudge", fields: [judgeId], references: [id])

  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  // COMPLETED is permanent (Section 5) — no further transition once
  // reached, enforced at the application layer (nothing in the schema
  // itself can express "this enum value, once set, is final"). Module 8
  // is what actually drives IN_PROGRESS/COMPLETED; this module only ever
  // writes PENDING (on create) and TRANSFERRED (on transfer).
  status AssignmentStatus @default(PENDING)

  // Audit/provenance only (Section 4) — no downstream code branches on
  // this value.
  assignmentMethod AssignmentMethod

  // Set on the *new* row created by a transfer, pointing back at the
  // TRANSFERRED row it replaced (Section 5). Self-relation, so Prisma
  // needs an explicit disambiguating name even though only one side
  // (this fk) is ever populated — the reverse list is never queried by
  // name, just useful for referential integrity.
  transferredFromAssignmentId String?           @unique
  transferredFromAssignment   JudgeAssignment?  @relation("AssignmentTransfer", fields: [transferredFromAssignmentId], references: [id])
  transferredToAssignment     JudgeAssignment?  @relation("AssignmentTransfer")

  assignedAt  DateTime  @default(now())
  completedAt DateTime?
}

enum AssignmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  TRANSFERRED
}

enum AssignmentMethod {
  MANUAL
  ALGORITHMIC
}

// Module 7 — platform-wide, not event-scoped (Section 5). Never visible
// to the judge themselves or to any participant; visible to any
// organizer/admin viewing this judge's profile on any event, including
// ones unrelated to eventId below.
model JudgeReliabilityNote {
  id String @id @default(uuid())

  judgeUserId String
  judgeUser   User   @relation("ReliabilityNoteSubject", fields: [judgeUserId], references: [id], onDelete: Cascade)

  // Context only — which event this incident occurred during. The note
  // itself is never scoped or filtered by this field.
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  authorUserId String
  author       User   @relation("ReliabilityNoteAuthor", fields: [authorUserId], references: [id])

  remark String

  createdAt DateTime @default(now())

  @@index([judgeUserId])
}

// Append-only. Every privileged or destructive action writes here —
// see CLAUDE.md's non-negotiable principle 5. Never updated, never
// deleted.
model AuditLog {
  id String @id @default(uuid())

  actorUserId String
  actor       User   @relation(fields: [actorUserId], references: [id])

  action       String
  metadataJson Json

  createdAt DateTime @default(now())

  @@index([actorUserId])
}
