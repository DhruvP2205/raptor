// The schema. docs/DATA-MODEL.md is the source of truth — this file
// implements what that document says, module by module, in the order
// docs/stages/ locks them. Models land here only as each stage doc is
// actually implemented; nothing here should ever be ahead of a locked
// stage doc. If this file and DATA-MODEL.md ever disagree, that's a bug
// — see CLAUDE.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Module 1 (Auth & Email) — see docs/stages/01-auth-and-email-setup.md.
model User {
  id           String  @id @default(uuid())
  email        String  @unique
  passwordHash String
  displayName  String

  emailVerifiedAt DateTime?

  // Single outstanding email-verification token, hashed (see D54,
  // docs/DECISIONS.md) — not cleared on successful verification.
  // emailVerifiedAt is what gates single-use behavior; keeping the hash
  // around lets a repeat hit on the same verify link resolve to this
  // user and be recognized as an idempotent no-op instead of "invalid
  // token". Overwritten (invalidating the previous token) on signup
  // and on every resend.
  verificationTokenHash      String?   @unique
  verificationTokenExpiresAt DateTime?

  // bannedByUserId (audit: who issued the ban) is deferred — no
  // ban-issuing endpoint exists yet; these two fields only support the
  // signup-time rejection check this stage's doc requires.
  bannedAt     DateTime?
  bannedReason String?

  // Module 2 (Roles & Membership) — see
  // docs/stages/02-roles-and-membership.md Section 2. Set once, at
  // creation, by whichever code path creates the account (self-signup
  // always PARTICIPANT; admin-created staff accounts choose JUDGE or
  // ORGANIZER) — never edited afterward, by design. No Prisma-level
  // default: every creation path must be explicit about what it's
  // creating, rather than silently relying on an implicit default.
  accountType AccountType

  // True for admin-created staff accounts until their first
  // /auth/set-password call. Never true for self-signed-up participants.
  mustResetPassword Boolean @default(false)

  // Platform-operator flag, orthogonal to accountType. Provisioned only
  // outside normal app flow (scripts/bootstrap-admin.ts) — there is no
  // in-app "create a site admin" action.
  siteAdmin Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]

  memberships     EventMembership[] @relation("MemberUser")
  sentInvitations EventMembership[] @relation("InvitingUser")
  auditLogEntries  AuditLog[]

  adminOfTeams    Team[]           @relation("TeamAdmin")
  teamMemberships TeamMembership[]
  soloSubmissions Submission[]

  // Module 6 — organizer/admin who resolved a verification's
  // finalDecision. Nullable on the other side (most SubmissionVerification
  // rows are never manually reviewed at all, e.g. auto-VERIFIED ones).
  verificationReviews SubmissionVerification[] @relation("VerificationReviewer")

  // Module 7 — projects this user, as a judge, has been assigned to.
  judgeAssignments JudgeAssignment[] @relation("AssignmentJudge")

  // Reliability notes about this user (as the judge the incident is
  // about) vs. notes this user has authored (as the organizer/admin who
  // wrote one about someone else) are two entirely different relations
  // on the same table — Section 5, docs/stages/07-judge-assignment.md.
  reliabilityNotesAbout    JudgeReliabilityNote[] @relation("ReliabilityNoteSubject")
  reliabilityNotesAuthored JudgeReliabilityNote[] @relation("ReliabilityNoteAuthor")

  // Module 9 (Normalization) — platform-wide, live-updating personal
  // scoring-tendency profile (Section 3, docs/stages/09-normalization.md,
  // D122). Recomputed after *every* submit-review this user makes, as
  // judge, across all events ever — never reset per event. Defaults to
  // 0/0/0 for a judge who has never completed a review; sampleCount is
  // what's checked against the minimum-N=3 threshold (D123).
  judgeCalibrationMean        Float @default(0)
  judgeCalibrationStdDev      Float @default(0)
  judgeCalibrationSampleCount Int   @default(0)

  normalizationRunsTriggered NormalizationRun[] @relation("NormalizationRunAuthor")

  // Module 10 — provenance only (who drafted/published/corrected a
  // result), two distinct relation names since one user can plausibly
  // do both for the same event (docs/stages/10-results-and-rankings.md
  // Section 8).
  resultsDraftsCreated       ResultsDraft[]            @relation("ResultsDraftCreator")
  publishedResultVersions    PublishedResultVersion[]  @relation("ResultVersionPublisher")

  // Module 11 (Voting) — six distinct relation names since one user can
  // plausibly occupy several of these roles across the platform's
  // lifetime (an organizer who also votes as a verified user on another
  // event, etc.), same multi-relation-per-table precedent as Module 10
  // above.
  votingRoundsCreated       VotingRound[]          @relation("VotingRoundCreator")
  votingRoundsDeactivated   VotingRound[]          @relation("VotingRoundDeactivator")
  shortlistEntriesAdded     ShortlistEntry[]        @relation("ShortlistEntryAdder")
  votesCast                 Vote[]                  @relation("VoteCaster")
  voteAbuseFlagsReviewed    VoteAbuseFlag[]         @relation("VoteAbuseFlagReviewer")
  votingResultVersionsPublished VotingResultVersion[] @relation("VotingResultVersionPublisher")

  // Module 12 (Certificates) — `certificates` is every Certificate this
  // user is the recipient of (the public gallery's own data source,
  // Section 7); `certificatesEnabledForEvents` is provenance-only, the
  // organizer/admin who flipped the switch (Section 2.1).
  certificates                 Certificate[]          @relation("CertificateRecipient")
  certificatesEnabledForEvents Event[]                @relation("CertificatesEnabler")
}

model Session {
  id        String  @id @default(uuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String  @unique

  userAgent String?
  ipHash    String?

  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

enum AccountType {
  PARTICIPANT
  JUDGE
  ORGANIZER
}

// Module 2 introduced this as a deliberately minimal anchor (D59); this
// is now Module 3's (docs/stages/03-event-management.md) full shape,
// with maxTeamSize (Module 4, D75), trackAttachmentMode (Module 5),
// maxProjectsPerJudge (Module 7), finalScoreDisplayScale/
// judgingClosesAt (Module 8), and votingEligibilityMode/eventClosedAt
// (Module 11) added additively on top as each owning module landed.
model Event {
  id   String @id @default(uuid())
  name String

  // Editable only while status = DRAFT (D17-equivalent, Section 3.2).
  // Auto-generated from name at creation (slugified), organizer can
  // override while still DRAFT — see D68 in docs/DECISIONS.md for why
  // this is inferred rather than stated outright.
  slug String @unique

  // Markdown source, never rendered HTML — sanitized identically on
  // every render (preview and production), see Section 6. Optional:
  // nothing in this stage's doc requires a description before publish.
  description String?

  posterUrl    String?
  thumbnailUrl String?

  status EventStatus @default(DRAFT)

  // Module 4's field (Team Management), not Module 3's — flagged as
  // not-yet-implemented in DATA-MODEL.md until now. Admin counts toward
  // the total: maxTeamSize 4 means 1 admin + up to 3 more members, not
  // 4 on top of the admin (Section 5, docs/stages/04-team-management.md).
  // Defaults to 4 if not set at creation — an inferred default, not
  // stated by either module's doc; see D75 in docs/DECISIONS.md.
  maxTeamSize Int @default(4)

  // Module 5's field (Submission Management) — drives which
  // track-selection UI the submission form shows (Section 4,
  // docs/stages/05-submission-management.md). Defaults to NONE: an
  // organizer who never configures tracks gets a form with no track
  // field at all, rather than a form that silently requires one.
  trackAttachmentMode TrackAttachmentMode @default(NONE)

  // Module 7's field (Judge Assignment) — event-wide default cap on how
  // many projects a single judge can be assigned, referenced by both
  // manual and algorithmic assignment (Section 3/4,
  // docs/stages/07-judge-assignment.md). A per-judge
  // EventMembership.projectLimitOverride can raise or lower this for one
  // judge. Defaults to 20 — an inferred default (not stated by the
  // doc), generous enough to rarely block a small event's first
  // assignment pass while still being a real, visible cap rather than
  // effectively unbounded; same "additive field, sensible default"
  // precedent as maxTeamSize (D75).
  maxProjectsPerJudge Int @default(20)

  // Module 8's field (Rubric & Scoring) — organizer-configured
  // judge-input-scale-to-display-scale multiplier (Section 3.3,
  // docs/stages/08-rubric-and-scoring.md). Deliberately never the same
  // number as the 0-100 judge input scale — a judge always enters
  // 0-100 per criterion regardless of what this is set to.
  finalScoreDisplayScale Int @default(5)

  // Module 11's field (Voting, Section 2, D43) — organizer-chosen once
  // at the event level, not re-configurable per round. Nullable: the
  // doc describes this as "chosen, once," not necessarily at event
  // creation time (organizer may not be ready to decide voting policy
  // months before voting matters); VotingService enforces that it must
  // be set before round 1 can be created, and locks it immutable once
  // round 1 exists — same "locked once round 1 exists" precedent as the
  // shortlist (Section 4). This field is discussed by name in Section 2
  // of docs/stages/11-voting.md but was never formally placed in that
  // doc's own Section 10 (Data Model) table — cross-doc gap, resolved
  // here rather than left unimplemented; see docs/DATA-MODEL.md §11.
  votingEligibilityMode VotingEligibilityMode?

  // Module 12's fields (Certificates, Section 2.1) — single, unified
  // event-wide switch. `certificatesEnabled` can only ever flip
  // true->once validated against a LIVE PublishedResultVersion existing
  // (Module 10) — CertificatesService enforces this, not the schema.
  // One switch controls issuance for participants and judges alike.
  certificatesEnabled         Boolean   @default(false)
  certificatesEnabledAt       DateTime?
  certificatesEnabledByUserId String?
  certificatesEnabledByUser   User?     @relation("CertificatesEnabler", fields: [certificatesEnabledByUserId], references: [id])

  // Timeline — all required at creation (Section 3.3's ordering chain
  // can't be validated against a partially-set timeline). UTC.
  // judgingClosesAt (Module 8, D108) sits between eventEndsAt and
  // resultsAnnounceAt — Module 3's original design modeled judging as
  // an implicit, unstored gap; this replaces that with a real,
  // organizer-set boundary that submit-review/PATCH scores actually
  // enforce (Section 7 there). eventClosedAt (Module 11, D49/D142) is
  // the upper bound of the voting-round-restart window (Section 7,
  // docs/stages/11-voting.md) — added as a required timeline field
  // following the exact same additive precedent judgingClosesAt set
  // for Module 8, strictly after votingWinnerAnnounceAt. It introduces
  // no new EventPhase value: the voting doc never names one for it, and
  // every Module 11 visibility/gating rule is explicitly defined in
  // terms of PublishedResultVersion/VotingResultVersion status, not
  // EventPhase (Section 8/9) — so it's added to the ordering chain only,
  // not to event-phase.ts's PHASE_BOUNDARIES.
  registrationOpensAt    DateTime
  registrationClosesAt   DateTime
  eventStartsAt          DateTime
  submissionsOpenAt      DateTime
  submissionsCloseAt     DateTime
  eventEndsAt            DateTime
  judgingClosesAt        DateTime
  resultsAnnounceAt      DateTime
  votingOpensAt          DateTime
  votingClosesAt         DateTime
  votingWinnerAnnounceAt DateTime
  eventClosedAt          DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships EventMembership[]
  tracks      Track[]
  prizes      Prize[]
  teams       Team[]
  submissions Submission[]

  judgeAssignments JudgeAssignment[]

  // Module 7 — context-only relation (the note itself is platform-wide
  // on the judge's User, not scoped by this relation — Section 5,
  // docs/stages/07-judge-assignment.md).
  judgeReliabilityNotes JudgeReliabilityNote[]

  // Module 8 — the rubric, defined once as a whole set (Section 2,
  // docs/stages/08-rubric-and-scoring.md) — see RubricCriterion's own
  // comment for why this is a replace-the-whole-set write, not
  // per-row CRUD like Track/Prize.
  rubricCriteria RubricCriterion[]

  // Module 9 — every normalization run ever triggered for this event;
  // never overwritten or deleted by a later run (Section 6,
  // docs/stages/09-normalization.md).
  normalizationRuns NormalizationRun[]

  // Module 10 — every draft/published version ever created for this
  // event, across its whole history including superseded/unpublished
  // ones (Section 8, docs/stages/10-results-and-rankings.md).
  resultsDrafts            ResultsDraft[]
  publishedResultVersions  PublishedResultVersion[]

  // Module 11 — every voting round ever created for this event
  // (including DEACTIVATED ones, kept for audit, Section 7) and every
  // voting-results version ever published (Section 9), same
  // never-deleted history pattern as Module 10's relations above.
  votingRounds          VotingRound[]
  votingResultVersions  VotingResultVersion[]

  // Module 12 — every certificate ever issued for this event, and every
  // template version ever uploaded (append-only, Section 8,
  // docs/stages/12-certificates.md).
  certificates         Certificate[]
  certificateTemplates CertificateTemplate[]
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  DELETED
}

// Module 11 (Voting) — see docs/stages/11-voting.md Section 2/D43.
enum VotingEligibilityMode {
  PARTICIPANTS_ONLY
  VERIFIED_PLATFORM_USERS
}

enum TrackAttachmentMode {
  NONE
  SINGLE
  MULTIPLE
}

model Track {
  id     String @id @default(uuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prizes Prize[]

  // Unique per event, not globally (Section 5).
  @@unique([eventId, name])
}

enum PrizeDecidedBy {
  JUDGES
  PUBLIC_VOTE
}

model Prize {
  id      String @id @default(uuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  trackId String?
  track   Track?  @relation(fields: [trackId], references: [id], onDelete: SetNull)

  name       String
  rank       Int
  decidedBy  PrizeDecidedBy

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum EventRole {
  PARTICIPANT
  JUDGE
  ORGANIZER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

// The single table every authorization guard checks (Section 4,
// docs/stages/02-roles-and-membership.md) — no global role field is
// ever consulted for event-scoped actions. Folds judge-invitation
// lifecycle in directly rather than a separate JudgeInvitation table
// (Section 5) — there's no point in this relationship's life where two
// tables would represent it at different stages.
model EventMembership {
  id String @id @default(uuid())

  userId String
  user   User   @relation("MemberUser", fields: [userId], references: [id], onDelete: Cascade)

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  role EventRole

  // Judge track-scoping. Empty = all tracks. The field exists now per
  // Section 5; the mechanics of actually scoping a judge's assignment
  // by track are explicitly out of scope until judge assignment
  // (Module 7+) — see Section 1's "Explicitly not in this stage."
  trackIds String[] @default([])

  // Module 7 — per-judge override of Event.maxProjectsPerJudge, set
  // explicitly by an organizer when a manual assignment would otherwise
  // exceed the event-wide default (Section 3,
  // docs/stages/07-judge-assignment.md). null = use the event default.
  projectLimitOverride Int?

  // ACCEPTED immediately for organizer rows (D12, docs/DECISIONS.md) —
  // there's no consent step for an already-vetted organizer account.
  // Starts PENDING for judge rows. Only ACCEPTED rows grant any access,
  // anywhere — a PENDING row exists in this table but must behave
  // identically to no row at all for every guard check.
  invitationStatus InvitationStatus @default(PENDING)

  invitedByUserId String?
  invitedBy       User?   @relation("InvitingUser", fields: [invitedByUserId], references: [id])
  invitedAt       DateTime?
  respondedAt     DateTime?

  // Hashed, single-use, same pattern as every other token in this
  // project (Module 1's session/verification tokens). No stored expiry
  // snapshot for the token itself — deliberately resolved in
  // docs/stages/03-event-management.md Section 4: the invitation
  // deadline is always computed live as event.eventStartsAt, so an
  // organizer editing the event's start date after invitations go out
  // automatically moves the effective deadline for every still-PENDING
  // invitation.
  invitationTokenHash String? @unique

  createdAt DateTime @default(now())

  // One membership row per user per event — a user can't simultaneously
  // hold two roles (or two separate pending invitations) on the same
  // event.
  @@unique([userId, eventId])
}

// Module 4 (Team Management) — see docs/stages/04-team-management.md.
model Team {
  id      String @id @default(uuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Immutable once set (D21-equivalent, Section 3) — no rename under
  // any circumstance. Unique per event, not globally.
  name String

  // Fixed, non-transferable (Section 6) — no ownership-transfer
  // mechanism anywhere. The only way this relationship ends is the team
  // being deleted; there is no intermediate "team with no admin" state.
  adminUserId String
  admin       User   @relation("TeamAdmin", fields: [adminUserId], references: [id])

  // Join code is `${joinLinkPrefix}-${joinLinkSuffix}`, e.g.
  // "team-xmass-482913". joinLinkPrefix (slugified name alone, D76) is
  // derived once at creation and never changes, since name never
  // changes (Section 4.1). joinLinkSuffix is the actual rotating
  // credential (Section 4.2) — regeneration only ever touches this
  // field, invalidating the previous value immediately. The pair is
  // globally unique (not just per event) because /teams/join resolves
  // a team from the code alone, with no event in the URL.
  joinLinkPrefix String
  joinLinkSuffix String

  createdAt DateTime @default(now())

  members    TeamMembership[]
  submission Submission?

  // Module 12 — certificates whose team-name field is sourced from this
  // team (nullable on Certificate; solo participants have none).
  certificates Certificate[]

  @@unique([eventId, name])
  @@unique([joinLinkPrefix, joinLinkSuffix])
}

model TeamMembership {
  id     String @id @default(uuid())
  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  // A user can only be on one team per event — enforced at the
  // application layer by checking across all of an event's teams
  // (there's no direct eventId column here to index on), not by a DB
  // constraint on this table alone.
  @@unique([teamId, userId])
}

// Module 5 (Submission Management) — see
// docs/stages/05-submission-management.md. teamId/everSubmitted started
// as a deliberately minimal anchor in Module 4 (D75), since Module 4's
// roster lock (Section 6 there) needs `everSubmitted` to exist before
// this module's own create/submit/unsubmit logic does. Everything else
// below is this module's full shape.
model Submission {
  id      String @id @default(uuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  submissionType SubmissionType

  // Exactly one of teamId/soloUserId is set, never both, never neither
  // — enforced at the application layer (Section 3), not a DB
  // constraint, since Postgres has no native "exactly one of these two
  // columns is non-null" check short of a CHECK constraint this schema
  // doesn't use elsewhere.
  teamId String? @unique
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  soloUserId String?
  soloUser   User?   @relation(fields: [soloUserId], references: [id])

  // Everything below is optional at the row level — a draft can be an
  // empty shell (Section 5.1). `submit` is what enforces non-empty
  // required fields, not the schema.
  title        String?
  description  String?
  repoUrl      String?
  demoVideoUrl String?
  liveUrl      String?

  // Works for both SINGLE and MULTIPLE trackAttachmentMode with one
  // shape — SINGLE just constrains the array to length 1 at validation
  // time (Section 7).
  trackIds String[] @default([])

  // The only distinction between in-progress and finalized (Section 5)
  // — no separate draft table.
  isDraft Boolean @default(true)

  // Always the most recent submit action's timestamp, overwritten on
  // every resubmit (Section 5.3) — not preserved from the first submit.
  submittedAt DateTime?

  // Set true on first successful submit, never reset — Module 4's
  // roster lock (D26) keys off this, not isDraft, so it has to survive
  // any number of later unsubmit/resubmit cycles.
  everSubmitted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Module 6 — one verification record per submission, created lazily
  // (NOT_RUN default) rather than backfilled for every existing row.
  verification SubmissionVerification?

  // Module 7 — zero or more judges assigned once finalDecision =
  // APPROVED (Section 2, docs/stages/07-judge-assignment.md). The
  // normal case is several (the brief's own example is 3 reviews per
  // project), so this is a list, unlike verification's 1:1.
  judgeAssignments JudgeAssignment[]

  // Module 9 — one NormalizedScore per normalization run this
  // submission was included in (Section 9,
  // docs/stages/09-normalization.md).
  normalizedScores NormalizedScore[]

  // Module 10 — one entry per published version this submission
  // appears in, across the event's full correction history (Section 8,
  // docs/stages/10-results-and-rankings.md).
  rankResultEntries         RankResultEntry[]
  specialAwardResultEntries SpecialAwardResultEntry[]

  // Module 11 — every shortlist entry, vote, and voting-results entry
  // this submission has ever been part of, across every round/version
  // in the event's history (Section 10, docs/stages/11-voting.md).
  shortlistEntries    ShortlistEntry[]
  votesReceived       Vote[]
  votingResultEntries VotingResultEntry[]

  // Module 12 — certificates whose project-name field is sourced from
  // this submission (nullable on Certificate; judge certificates have
  // none, docs/stages/12-certificates.md Section 8).
  certificates Certificate[]

  // NULLs are distinct under Postgres's default unique-index semantics,
  // so this only constrains actual (eventId, soloUserId) pairs — it
  // doesn't limit how many TEAM rows (soloUserId always null) an event
  // can have.
  @@unique([eventId, soloUserId])
}

enum SubmissionType {
  SOLO
  TEAM
}

// Module 6 (Submission Verification) — see
// docs/stages/06-submission-verification.md. One row per Submission,
// overwritten on re-run (D101) — this is the current state, not a
// history log; ScoreRevision-style immutable snapshots aren't needed
// here because nothing downstream depends on a specific past run the
// way judging depends on past score submissions.
model SubmissionVerification {
  id String @id @default(uuid())

  submissionId String     @unique
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  // What the automated check found (or NOT_RUN if it hasn't run yet).
  // Deliberately separate from finalDecision (Section 4) — VERIFIED is
  // the only value that auto-resolves finalDecision; every other value
  // requires an explicit human action (D93, D94).
  checkStatus CheckStatus @default(NOT_RUN)

  // What actually gates Module 7's judge assignment. Never set directly
  // by the automated check except the one VERIFIED -> APPROVED path.
  finalDecision FinalDecision @default(PENDING_REVIEW)

  firstCommitAt DateTime?
  lastCommitAt  DateTime?

  totalCommits    Int @default(0)
  commitsInWindow Int @default(0)

  // Full sha/timestamp/message/author detail for every commit outside
  // [eventStartsAt, submissionsCloseAt] (Section 3.4) — retained for the
  // manual-review UI, never discarded down to just a count.
  outsideWindowCommits Json @default("[]")

  // Mandatory (enforced at the application layer, not the schema —
  // same pattern as every other conditionally-required field in this
  // project) when finalDecision = DISQUALIFIED (D99). Optional for an
  // APPROVED override.
  finalDecisionRemarks String?

  reviewedByUserId String?
  reviewedBy       User?   @relation("VerificationReviewer", fields: [reviewedByUserId], references: [id])

  checkedAt  DateTime?
  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CheckStatus {
  NOT_RUN
  VERIFIED
  SUSPICIOUS
  REJECTED
  PRIVATE
  NON_GITHUB
  ERROR
}

enum FinalDecision {
  PENDING_REVIEW
  APPROVED
  DISQUALIFIED
}

// Module 6's one deliberate exception to "never store a reversible
// secret" (D96) — a GitHub PAT must be read back in plaintext to call
// the GitHub API, unlike every hashed, compare-only token elsewhere in
// this schema. Admin-managed only (Section 5); never surfaced to
// organizers.
model GithubToken {
  id String @id @default(uuid())

  // AES-256-GCM ciphertext (iv + authTag + ciphertext, see
  // apps/worker's crypto helper) — the encryption key itself lives only
  // in the GITHUB_TOKEN_KEY env var, sourced from a Docker secret, never
  // in this table.
  tokenEncrypted String

  // Admin-facing name, e.g. "Token A - org bot account" — tokens are
  // never identified to anyone by their value.
  label String

  // Flipped to false the moment a call using this token fails auth
  // (expired/revoked on GitHub's side) — excluded from rotation from
  // that point on and surfaced as an admin-dashboard alert (D97), never
  // a silent failure.
  isValid Boolean @default(true)

  // Read from GitHub's rate-limit response headers after every call.
  // Rotation picks whichever valid, non-revoked token currently has the
  // most headroom; a token past its rateLimitResetAt with 0 remaining is
  // skipped until that time passes.
  rateLimitRemaining Int?
  rateLimitResetAt   DateTime?

  lastUsedAt DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Module 7 (Judge Assignment) — see
// docs/stages/07-judge-assignment.md. Decides *who* reviews *what*, not
// scoring itself (Module 8). submissionId is intentionally not unique —
// a project normally has several judges (Section 3).
model JudgeAssignment {
  id String @id @default(uuid())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  judgeId String
  judge   User   @relation("AssignmentJudge", fields: [judgeId], references: [id])

  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  // COMPLETED is permanent (Section 5) — no further transition once
  // reached, enforced at the application layer (nothing in the schema
  // itself can express "this enum value, once set, is final"). Module 8
  // is what actually drives IN_PROGRESS/COMPLETED; this module only ever
  // writes PENDING (on create) and TRANSFERRED (on transfer).
  status AssignmentStatus @default(PENDING)

  // Audit/provenance only (Section 4) — no downstream code branches on
  // this value.
  assignmentMethod AssignmentMethod

  // Set on the *new* row created by a transfer, pointing back at the
  // TRANSFERRED row it replaced (Section 5). Self-relation, so Prisma
  // needs an explicit disambiguating name even though only one side
  // (this fk) is ever populated — the reverse list is never queried by
  // name, just useful for referential integrity.
  transferredFromAssignmentId String?           @unique
  transferredFromAssignment   JudgeAssignment?  @relation("AssignmentTransfer", fields: [transferredFromAssignmentId], references: [id])
  transferredToAssignment     JudgeAssignment?  @relation("AssignmentTransfer")

  assignedAt  DateTime  @default(now())
  completedAt DateTime?

  // Module 8 (Rubric & Scoring) — the judge's actual scoring work
  // against this assignment. review is 1:1 (one judge, one submission,
  // one feedback text); scores/revisions are lists (one Score per
  // rubric criterion, one ScoreRevision per submit-review call).
  scores    Score[]
  review    JudgeReview?
  revisions ScoreRevision[]

  // Module 9 — one snapshot per normalization run this assignment's
  // rawTotal was ever fed into (Section 9,
  // docs/stages/09-normalization.md) — a list, since the event can be
  // (re-)normalized any number of times before resultsAnnounceAt.
  normalizedScores NormalizedJudgeScore[]
}

enum AssignmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  TRANSFERRED
}

enum AssignmentMethod {
  MANUAL
  ALGORITHMIC
}

// Module 7 — platform-wide, not event-scoped (Section 5). Never visible
// to the judge themselves or to any participant; visible to any
// organizer/admin viewing this judge's profile on any event, including
// ones unrelated to eventId below.
model JudgeReliabilityNote {
  id String @id @default(uuid())

  judgeUserId String
  judgeUser   User   @relation("ReliabilityNoteSubject", fields: [judgeUserId], references: [id], onDelete: Cascade)

  // Context only — which event this incident occurred during. The note
  // itself is never scoped or filtered by this field.
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  authorUserId String
  author       User   @relation("ReliabilityNoteAuthor", fields: [authorUserId], references: [id])

  remark String

  createdAt DateTime @default(now())

  @@index([judgeUserId])
}

// Module 8 (Rubric & Scoring) — see docs/stages/08-rubric-and-scoring.md
// Section 2. Three kinds sharing one table, differentiated by `kind`
// rather than three separate models — they're all "a thing a judge
// scores while reviewing one submission," just with different valid
// value ranges and different treatment in the final-score formula
// (Section 3). Written as a whole-set replace
// (PUT /events/:id/rubric-criteria, not per-criterion CRUD like
// Track/Prize) because the SCORING kind's weightPercent values must
// sum to exactly 100 across the *entire* set (D114) — a constraint
// that can't be validated one row at a time.
model RubricCriterion {
  id      String @id @default(uuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  kind RubricCriterionKind

  label       String
  description String

  // SCORING only. Must sum to exactly 100 across an event's SCORING
  // criteria (D114) — enforced in RubricCriteriaService, not here;
  // Postgres has no native "these rows across the table sum to X"
  // constraint.
  weightPercent Int?

  // BONUS only. Flat point value, never a percentage (Section 2.2).
  maxPoints Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scores Score[]

  // Module 10 — SPECIAL_AWARD criteria only in practice (Section 4,
  // docs/stages/10-results-and-rankings.md), but not schema-restricted
  // to that kind for the same reason Score isn't restricted either.
  specialAwardResultEntries SpecialAwardResultEntry[]
}

enum RubricCriterionKind {
  SCORING
  BONUS
  // Added retroactively (D129) — see stage doc Section 2.3. Never part
  // of the rawTotal/finalScore formula; tallied separately by
  // nomination count at results time (Module 10).
  SPECIAL_AWARD
}

// Section 8, docs/stages/08-rubric-and-scoring.md. The live, current
// value per judge per criterion — mutable by the assigning judge until
// judgingClosesAt (D110). Valid range depends entirely on the parent
// criterion's kind (SCORING: 0-100, BONUS: 0-maxPoints,
// SPECIAL_AWARD: 0 or 1) — enforced at the application layer, since a
// single `value` column can't carry a kind-conditional range check in
// the schema itself.
model Score {
  id String @id @default(uuid())

  judgeAssignmentId String
  judgeAssignment   JudgeAssignment @relation(fields: [judgeAssignmentId], references: [id], onDelete: Cascade)

  criterionId String
  criterion   RubricCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  value Int
  note  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One value per judge per criterion per assignment — a resubmit
  // overwrites the existing row (Section 4.1's "the live, current
  // value"), it never creates a second one.
  @@unique([judgeAssignmentId, criterionId])
}

// One per JudgeAssignment (Section 8) — the judge's own-words
// justification, required to complete submit-review (D112).
model JudgeReview {
  id String @id @default(uuid())

  judgeAssignmentId String          @unique
  judgeAssignment   JudgeAssignment @relation(fields: [judgeAssignmentId], references: [id], onDelete: Cascade)

  overallFeedback String

  // Most recent submit/resubmit timestamp — same "most recent, not
  // original" pattern as Submission.submittedAt (Module 5, D31).
  submittedAt DateTime

  // Convenience counter, incremented on every resubmit — mirrors
  // ScoreRevision.revisionNumber but avoids a COUNT query to display
  // it. Both are always kept in sync by ScoringService, never derived
  // independently.
  revisionCount Int @default(0)
}

// Append-only, never edited or deleted (Section 5) — a full snapshot
// per successful submit-review call, not a diff. Draft saves
// (PATCH .../scores) never write here (D111) — only a validated,
// completed submit does, which is what keeps this log meaningful
// rather than filled with autosave noise.
model ScoreRevision {
  id String @id @default(uuid())

  judgeAssignmentId String
  judgeAssignment   JudgeAssignment @relation(fields: [judgeAssignmentId], references: [id], onDelete: Cascade)

  revisionNumber Int

  // Every criterion's value + note as they stood at this submission —
  // deliberately a full snapshot, not a diff (Section 5), so a past
  // revision is readable on its own without replaying history.
  scoresSnapshotJson    Json
  overallFeedbackSnapshot String

  submittedAt DateTime @default(now())

  @@unique([judgeAssignmentId, revisionNumber])
}

// Module 9 (Normalization) — see docs/stages/09-normalization.md
// Section 6/9. Manual, unlimited re-runs while judgingClosesAt <=
// now() < resultsAnnounceAt (D126); permanently locked after
// resultsAnnounceAt with no admin override — enforced in
// NormalizationService, not here, same as every other server-time
// deadline in this platform. Every run is independent; an earlier
// run's rows are never overwritten or deleted by a later one.
model NormalizationRun {
  id String @id @default(uuid())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  runByUserId String
  runByUser   User   @relation("NormalizationRunAuthor", fields: [runByUserId], references: [id])

  runAt DateTime @default(now())

  // Only method for this stage (Section 9) — a real enum anyway, not a
  // bare string, so a future method addition is additive, not a schema
  // rewrite.
  method NormalizationMethod @default(Z_SCORE)

  // Stored per-run, not read live from a platform constant at query
  // time — historical accuracy if the platform default ever changes
  // later (Section 9's own note).
  minimumN Int

  // This run's event-wide baseline (Section 4), frozen at run time —
  // the minimum-N fallback target for judges below the threshold.
  eventMean   Float
  eventStdDev Float

  judgeScores       NormalizedJudgeScore[]
  normalizedScores  NormalizedScore[]

  // Module 10 — every draft ever built against this run (Section 2,
  // docs/stages/10-results-and-rankings.md); a run can be reselected by
  // more than one draft over time.
  resultsDrafts ResultsDraft[]
}

enum NormalizationMethod {
  Z_SCORE
}

// One per judge per submission per run (Section 9) — ties a snapshot
// to the specific review it was computed for. Every *At-run field is a
// frozen copy, never a live reference back to User.judgeCalibration*
// (Section 7's whole reason for existing) — a judge's global profile
// keeps moving after this row is written, and this row must not move
// with it.
model NormalizedJudgeScore {
  id String @id @default(uuid())

  normalizationRunId String
  normalizationRun   NormalizationRun @relation(fields: [normalizationRunId], references: [id], onDelete: Cascade)

  judgeAssignmentId String
  judgeAssignment   JudgeAssignment  @relation(fields: [judgeAssignmentId], references: [id], onDelete: Cascade)

  // The input value at run time — Module 8's rawTotal, recomputed fresh
  // from Score rows rather than read from a stored column (there isn't
  // one; rawTotal is never persisted, per Module 8's own design).
  rawTotal Float

  judgeMeanAtRun    Float
  judgeStdDevAtRun  Float
  sampleCountAtRun  Int

  // true if this judge was below minimum-N and eventMean/eventStdDev
  // was used instead of their own personal figures (Section 4).
  usedFallback Boolean

  // true if judgeStdDevAtRun = 0 (Section 5.1) — flagged, never
  // silently absorbed; visible to admin/organizer alongside the score.
  uniformScoringFlagged Boolean

  zScore Float

  @@unique([normalizationRunId, judgeAssignmentId])
}

// One per submission per run (Section 9).
model NormalizedScore {
  id String @id @default(uuid())

  normalizationRunId String
  normalizationRun   NormalizationRun @relation(fields: [normalizationRunId], references: [id], onDelete: Cascade)

  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  // Average of NormalizedJudgeScore.zScore across COMPLETED judges for
  // this submission only — same non-responder exclusion rule as
  // Module 8 (D116): a judge who never completed contributes to
  // neither the sum nor the divisor.
  averagedZScore Float

  // This run's linear rescale of averagedZScore onto 0-100, using the
  // actual min/max across every submission in this run.
  rescaledValue Float

  // Module 8's exact final step, reused as-is (Section 5) — the same
  // output shape whether or not normalization ran.
  finalScore Float

  // Within this run only — dense ranking (ties share a rank), same
  // convention Module 10 uses for the official results ranking; not
  // itself the official ranking (that's Module 10's job), just this
  // run's own ordering.
  rank Int

  @@unique([normalizationRunId, submissionId])
}

// Module 10 (Results & Rankings) — see
// docs/stages/10-results-and-rankings.md Section 5.1. Private scratch
// space: computed rank/special-award results are never persisted here
// (they're computed on the fly for preview, and only actually written
// as rows — RankResultEntry/SpecialAwardResultEntry — once a
// PublishedResultVersion exists, Section 8). A draft is just a pointer
// to a selected run plus organizer-controlled publish settings.
model ResultsDraft {
  id String @id @default(uuid())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  normalizationRunId String
  normalizationRun   NormalizationRun @relation(fields: [normalizationRunId], references: [id])

  // Gates auto-publish (Section 5.2) — an organizer must explicitly
  // flip this to READY; AUTO mode never fires against an IN_PROGRESS
  // draft even if resultsAnnounceAt has already passed (D136).
  draftStatus DraftStatus @default(IN_PROGRESS)
  publishMode PublishMode @default(MANUAL)

  createdByUserId String
  createdByUser   User   @relation("ResultsDraftCreator", fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())

  publishedVersions PublishedResultVersion[]
}

enum DraftStatus {
  IN_PROGRESS
  READY
}

enum PublishMode {
  AUTO
  MANUAL
}

// Section 5.3/7 — immutable once created; a correction or unpublish
// never edits a row here, only adds a new one or flips `status`
// (D139). versionNumber is strictly increasing per event; only one
// version is ever LIVE at a time in practice, but that's an
// application-layer invariant (NormalizationService-style), not a
// schema constraint.
model PublishedResultVersion {
  id String @id @default(uuid())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  versionNumber Int
  status        PublishedResultVersionStatus @default(LIVE)

  // Null for a version created purely by a Section 7 correction with
  // no new draft of its own (a correction reuses the same selected
  // run's data, just with one override applied) — see Section 8's own
  // note on this field.
  resultsDraftId String?
  resultsDraft   ResultsDraft? @relation(fields: [resultsDraftId], references: [id])

  publishedByUserId String
  publishedByUser   User     @relation("ResultVersionPublisher", fields: [publishedByUserId], references: [id])
  publishedAt       DateTime @default(now())

  // Required whenever this version resulted from a Section 7
  // correction, not an original publish (D139) — enforced at the
  // application layer, not the schema, same pattern as every other
  // conditionally-required text field in this project.
  correctionReason String?

  // Required if status = UNPUBLISHED (Section 5.4, D137).
  unpublishReason String?

  rankEntries         RankResultEntry[]
  specialAwardEntries SpecialAwardResultEntry[]

  @@unique([eventId, versionNumber])
}

enum PublishedResultVersionStatus {
  LIVE
  SUPERSEDED
  UNPUBLISHED
}

// One per submission per version (Section 8) — dense ranking, so
// multiple entries can legitimately share the same `rank` within one
// version when a tie survives the full cascade (Section 3, D132/D133).
model RankResultEntry {
  id String @id @default(uuid())

  publishedResultVersionId String
  publishedResultVersion   PublishedResultVersion @relation(fields: [publishedResultVersionId], references: [id], onDelete: Cascade)

  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  rank Int

  // Normally mirrors the selected NormalizationRun's
  // NormalizedScore.finalScore for this submission; isScoreOverridden
  // flags a Section 7 explicit-override correction, which is the only
  // code path that ever sets displayScore to something else.
  displayScore      Float
  isScoreOverridden Boolean @default(false)

  // Set by a Section 7 disqualify correction — excluded from
  // ranking/award display going forward, but the row itself is never
  // deleted (this platform's usual "never silently destroyed" rule).
  isDisqualified Boolean @default(false)

  @@unique([publishedResultVersionId, submissionId])
}

// One per (criterion, submission) per version (Section 8) — a
// SPECIAL_AWARD criterion's computed winner(s) for this version,
// Section 4's own tie-break cascade (distinct from RankResultEntry's).
model SpecialAwardResultEntry {
  id String @id @default(uuid())

  publishedResultVersionId String
  publishedResultVersion   PublishedResultVersion @relation(fields: [publishedResultVersionId], references: [id], onDelete: Cascade)

  criterionId String
  criterion   RubricCriterion @relation(fields: [criterionId], references: [id])

  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  nominationCount Int

  // True if this award was resolved via the tie-share outcome (Section
  // 4's cascade end state, D140) rather than a clean win.
  isShared Boolean @default(false)

  @@unique([publishedResultVersionId, criterionId, submissionId])
}

// Append-only. Every privileged or destructive action writes here —
// see CLAUDE.md's non-negotiable principle 5. Never updated, never
// deleted.
model AuditLog {
  id String @id @default(uuid())

  actorUserId String
  actor       User   @relation(fields: [actorUserId], references: [id])

  action       String
  metadataJson Json

  createdAt DateTime @default(now())

  @@index([actorUserId])
}

// Module 11 (Voting) — see docs/stages/11-voting.md Section 10. A round
// is never deleted, only DEACTIVATED via a full restart (Section 7) —
// its votes stay permanently attached for audit but are excluded from
// any live tally from that point forward (enforced at the application
// layer: VotingService only ever tallies/accepts votes against the
// current ACTIVE round).
model VotingRound {
  id String @id @default(uuid())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  roundNumber Int

  status VotingRoundStatus @default(ACTIVE)

  // Round 1 initializes from the event's own votingOpensAt/
  // votingClosesAt/votingWinnerAnnounceAt; a restart round gets fresh
  // organizer-set values at creation time (Section 7) — this table's
  // own columns, not a live read of Event's, so a restart's fresh
  // values never retroactively change what an already-DEACTIVATED
  // round's window was.
  votingOpensAt          DateTime
  votingClosesAt         DateTime
  votingWinnerAnnounceAt DateTime

  deactivatedAt       DateTime?
  deactivatedByUserId String?
  deactivatedByUser   User?     @relation("VotingRoundDeactivator", fields: [deactivatedByUserId], references: [id])
  // Mandatory, non-empty, enforced at the application layer — same
  // conditionally-required-text-field pattern as every other mandatory
  // reason in this project (Section 7).
  deactivationReason  String?

  createdByUserId String
  createdByUser   User     @relation("VotingRoundCreator", fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())

  shortlistEntries     ShortlistEntry[]
  votes                Vote[]
  abuseFlags           VoteAbuseFlag[]
  votingResultVersions VotingResultVersion[]

  @@unique([eventId, roundNumber])
}

// SUPERSEDED is declared because docs/stages/11-voting.md Section 10's
// own data-model table lists it for VotingRound.status, but no prose
// anywhere in that doc ever describes a transition that produces it —
// Section 7 only ever describes ACTIVE -> DEACTIVATED. Implemented
// exactly as the doc's table states rather than silently dropped, per
// CLAUDE.md ("code implements what the docs say"), but flagged here:
// current application code never writes SUPERSEDED to this field.
enum VotingRoundStatus {
  ACTIVE
  SUPERSEDED
  DEACTIVATED
}

// Section 4/10 — the ballot's candidate list for one round. Provenance
// only (addedByUserId/isAutoSuggested); no behavioral difference
// downstream between an auto-suggested and a manually-added entry.
model ShortlistEntry {
  id String @id @default(uuid())

  votingRoundId String
  votingRound   VotingRound @relation(fields: [votingRoundId], references: [id], onDelete: Cascade)

  submissionId String
  submission   Submission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  addedByUserId  String
  addedByUser    User    @relation("ShortlistEntryAdder", fields: [addedByUserId], references: [id])
  isAutoSuggested Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([votingRoundId, submissionId])
}

// Section 3/10 — single-choice ballot. Unique on (votingRoundId,
// userId): one pick per user per round, enforced at the database level
// as well as checked in application code before insert (Section 3).
model Vote {
  id String @id @default(uuid())

  votingRoundId String
  votingRound   VotingRound @relation(fields: [votingRoundId], references: [id], onDelete: Cascade)

  submissionId String
  submission   Submission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("VoteCaster", fields: [userId], references: [id], onDelete: Cascade)

  // HMAC-keyed on APP_SECRET, same one-way construction as
  // Session.ipHash (Module 1, D58) — a plain hash of an IP address is
  // reversible via lookup table; HMAC with a server-only key is what
  // actually makes it one-way. Always recorded regardless of
  // eligibility mode (Section 10's own note) — null only if APP_SECRET
  // isn't configured, same graceful-degradation precedent as Session.
  ipHash String?

  createdAt DateTime @default(now())

  @@unique([votingRoundId, userId])
}

// Section 5.2/10 — never an automatic block or ban (D47); a
// PENDING-review queue entry only. implicatedUserIds grows as more
// accounts are seen sharing the same flagged ipHash pattern within this
// round.
model VoteAbuseFlag {
  id String @id @default(uuid())

  votingRoundId String
  votingRound   VotingRound @relation(fields: [votingRoundId], references: [id], onDelete: Cascade)

  ipHash String

  implicatedUserIds String[] @default([])

  status VoteAbuseFlagStatus @default(PENDING)

  reviewedByUserId String?
  reviewedByUser   User?     @relation("VoteAbuseFlagReviewer", fields: [reviewedByUserId], references: [id])
  reviewedAt       DateTime?

  createdAt DateTime @default(now())

  @@unique([votingRoundId, ipHash])
}

enum VoteAbuseFlagStatus {
  PENDING
  REVIEWED_CLEARED
  REVIEWED_BANNED
}

// Section 9/10 — the voting equivalent of PublishedResultVersion
// (Module 10); immutable once created, never edited in place, only
// superseded (same D139-equivalent rule, restated for voting).
model VotingResultVersion {
  id String @id @default(uuid())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  votingRoundId String
  votingRound   VotingRound @relation(fields: [votingRoundId], references: [id])

  versionNumber Int
  status        VotingResultVersionStatus @default(LIVE)

  publishedByUserId String
  publishedByUser   User     @relation("VotingResultVersionPublisher", fields: [publishedByUserId], references: [id])
  publishedAt       DateTime @default(now())

  // Required whenever this version resulted from a post-publish
  // correction rather than an original publish; required if
  // status = UNPUBLISHED — same conditionally-required pattern as
  // PublishedResultVersion (Section 9, reusing Module 10's pattern).
  correctionReason String?
  unpublishReason  String?

  entries VotingResultEntry[]

  @@unique([eventId, versionNumber])
}

enum VotingResultVersionStatus {
  LIVE
  SUPERSEDED
  UNPUBLISHED
}

// One per submission per version (Section 10).
model VotingResultEntry {
  id String @id @default(uuid())

  votingResultVersionId String
  votingResultVersion   VotingResultVersion @relation(fields: [votingResultVersionId], references: [id], onDelete: Cascade)

  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  voteCount      Int
  votePercentage Float

  // True if resolved via the vote-count tie-share outcome (Section 9,
  // D142) — ties at the top share the win, no arbitrary tiebreaker.
  isSharedWin Boolean @default(false)

  // Post-publish correction only (Section 9, reusing Module 10's
  // correction pattern) — disqualifies this entry from the public
  // audience-choice result going forward; row itself never deleted.
  isDisqualified Boolean @default(false)

  @@unique([votingResultVersionId, submissionId])
}

// Module 12 (Certificates) — see docs/stages/12-certificates.md Section
// 8. Recipient is always resolved server-side from an authenticated
// account's own participation/judging record — never a free-text
// input anywhere in this table's write path (Section 2, the direct
// structural response to the zerodepshack.com vulnerability). Rows are
// never deleted or edited in place once issued — payloadJson/signature
// are a permanent, immutable record.
model Certificate {
  id String @id @default(uuid())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("CertificateRecipient", fields: [userId], references: [id], onDelete: Cascade)

  role CertificateRole

  // teamId null for solo participants and for JUDGE-role certificates
  // (Section 3); submissionId null for JUDGE-role certificates only.
  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)

  submissionId String?
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  // The facts the signature covers, canonicalized (recursively
  // key-sorted) before signing/verifying — Postgres's jsonb storage
  // does not preserve insertion order or exact formatting, so
  // verification always re-canonicalizes rather than trusting byte
  // -for-byte round-trip fidelity (D34).
  payloadJson Json

  // Ed25519. publicKeyId is a short fingerprint of the public key that
  // produced this signature (not a rotation registry — this platform
  // has exactly one active signing key at a time; see
  // certificate-signing.util.ts).
  signature   String
  publicKeyId String

  // Snapshotted at issue time (D35/D36's "versioned" requirement) —
  // templateId pins the exact immutable CertificateTemplate row this
  // certificate was rendered against; a later template edit creates a
  // new row (higher version) and never touches this one, so re-render
  // is byte-for-byte stable forever. templateVersion is a denormalized
  // copy of that row's own version, avoiding a join just to display it.
  templateId      String
  template        CertificateTemplate @relation(fields: [templateId], references: [id])
  templateVersion Int

  issuedAt DateTime @default(now())

  // Prevents duplicate issuance of the same role for the same person on
  // the same event — checked here (not just in application code) since
  // "generate mine" must be safely repeatable/idempotent against a
  // concurrent double-click.
  @@unique([eventId, userId, role])
}

enum CertificateRole {
  PARTICIPANT
  JUDGE
  WINNER
  SPECIAL_AWARD_WINNER
}

// Append-only, one row PER VERSION per event (Section 4/8) — an edit
// creates a NEW row with version+1 rather than mutating the previous
// one in place. This is the only way "an already-issued Certificate...
// continues rendering against that version forever, never
// retroactively changing appearance" (Section 5) can actually hold: if
// edits mutated a single row, the markup an old certificate was issued
// against would simply cease to exist the moment the template changed.
// "Current" template for an event = the row with the highest `version`
// for that eventId (CertificateTemplatesService.getCurrentForEvent).
model CertificateTemplate {
  id String @id @default(uuid())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Sanitized on upload via a real SVG/XML-aware parser, never
  // string/regex replacement (D36) — see
  // certificates/svg-template-sanitizer.util.ts. This is the only copy
  // ever stored; there is no parallel "raw" version kept anywhere.
  svgMarkup String

  version Int

  createdAt DateTime @default(now())

  certificates Certificate[]

  @@unique([eventId, version])
}
