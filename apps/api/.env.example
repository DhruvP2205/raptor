# Loaded automatically via dotenv (src/main.ts) for non-Docker local
# dev. Copy to apps/api/.env and fill in real values — never commit the
# real file. Has no effect inside Docker: this file is gitignored and
# excluded in .dockerignore, so it never exists in the built image, and
# Docker's own `environment:` blocks in docker-compose.yml are the real
# source of truth there (see the root .env.example for that side).
#
# Local-dev convention for Postgres: a dedicated PostgreSQL instance
# installed directly on the host, on port 5433 — deliberately NOT 5432,
# so it can't collide with any other Postgres already running on this
# machine, and deliberately NOT the same instance Docker Compose manages
# (that one has no host-published port at all, by design — see
# docs/ARCHITECTURE.md Section 4). Create it once:
#
#   createuser -h localhost -p 5433 -U postgres --login --pwprompt raptor
#   createdb   -h localhost -p 5433 -U postgres --owner=raptor raptor
#
# then run migrations against it:
#
#   pnpm --filter @raptor/api exec prisma migrate dev

DATABASE_URL=postgresql://raptor:raptor_dev_pw@localhost:5433/raptor

API_PORT=4000
PUBLIC_WEB_URL=http://localhost:3000

# Keyed-hash key for low-entropy values at rest (currently just
# Session.ipHash). Without this set, ipHash is simply left null rather
# than hashed with no key. Generate with: openssl rand -hex 32
APP_SECRET=generate-your-own-with-openssl-rand-hex-32

# SESSION_TTL_DAYS=30
# VERIFICATION_TOKEN_TTL_HOURS=24

# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=Raptor <noreply@example.com>

# Handy for local dev: logs the verification token/link to stdout
# instead of requiring a real inbox. NEVER set this in production — see
# docs/stages/01-auth-and-email-setup.md Section 5.
TEST_MODE=true

# --- Module 3: event management ---
# Where uploaded posters/thumbnails are stored on disk. Defaults to
# ./uploads (relative to apps/api) if unset.
# UPLOAD_DIR=./uploads

# Backs rate limiting on the upload endpoints (D72) — fails open if
# unreachable, so this is optional for local dev; no local Redis is
# required to exercise everything else in this module.
# REDIS_URL=redis://localhost:6379

# --- Module 6: submission verification ---
# AES-256-GCM key this process uses to encrypt a GitHub token when an
# admin adds one (POST /admin/github-tokens) — apps/worker needs the
# exact same value to decrypt it again. Required only to exercise that
# endpoint; everything else in this module works without it. Generate
# with: openssl rand -hex 32
# GITHUB_TOKEN_KEY=generate-your-own-with-openssl-rand-hex-32
# Note: REDIS_URL above (currently optional/fails-open for rate
# limiting) becomes load-bearing once you actually want verification
# jobs to run — the queue needs a real, reachable Redis.

# --- Module 11: voting ---
# REDIS_URL above becomes load-bearing here too, for the PoW/CAPTCHA
# challenge storage (fails open on a Redis outage, same as rate
# limiting — see PowCaptchaService).
# VOTE_POW_DIFFICULTY_BITS=20
# VOTE_ABUSE_IP_THRESHOLD=3

# --- Module 12: certificates ---
# Ed25519 key this process uses to sign/verify Certificate.payloadJson
# — a plain `openssl rand -hex 32` does NOT produce a valid Ed25519
# key; generate one with:
#   pnpm --filter @raptor/api exec ts-node -T \
#     src/scripts/generate-certificate-signing-key.ts
# Required only to enable/generate/verify certificates; everything else
# in this module's routes works without it.
# CERTIFICATE_SIGNING_KEY=generate-with-the-script-above

# --- Module 20: demo environment ---
# NEVER set this in production against real event data. When true,
# connects to a completely separate database (`<POSTGRES_DB>_demo`,
# e.g. `raptor_demo`) and seeds four fake, lifecycle-spanning events
# for a human to click through — the real `raptor` database is never
# touched, under any circumstance, while this is on. Defaults to false
# (ordinary behavior) if unset. See docs/design/20-demo-environment.md.
# DEMO_MODE=true

# --- Module 24: release closeout (production hardening) ---
# Defaults to true (the acceptance checker needs the fixture event and
# its seeded sessions present with zero manual steps). Set to false for
# a real deployment that shouldn't carry the fixture organizer's live
# credentials (THREAT-MODEL.md limit 5.7). Independent of DEMO_MODE —
# see docker-compose.yml's own comment for exactly how the two combine.
# FIXTURES_IMPORT=true

# Session cookie's `Secure` attribute — off by default (safe for local
# plain-HTTP runs). Set to true only once TLS actually terminates in
# front of this API in production; the browser silently refuses to send
# a Secure cookie back over plain HTTP, so turning this on without real
# TLS in front of it would break login entirely, not just weaken it.
# COOKIE_SECURE=true

# Login attempt limiter, keyed by (source IP, email) — generic 429,
# never reveals whether the email is registered. Defaults below.
# LOGIN_RATE_LIMIT_ATTEMPTS=10
# LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# Public gallery/submission-detail read limiter, keyed by source IP.
# Deliberately generous — the acceptance checker's own traffic (a
# handful of requests total, per .dogfood.toml) never comes close.
# GALLERY_RATE_LIMIT_PER_MINUTE=120
