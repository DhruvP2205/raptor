# Loaded automatically via dotenv (src/main.ts) for non-Docker local
# dev. Copy to apps/worker/.env and fill in real values — never commit
# the real file. Has no effect inside Docker — see apps/api/.env.example
# for the identical note on why.
#
# Point this at the same Postgres instance apps/api/.env.example uses
# for local dev (the host-installed one on :5433, already migrated by
# running `prisma migrate dev` from apps/api).
DATABASE_URL=postgresql://raptor:raptor_dev_pw@localhost:5433/raptor

# Needs a real, reachable Redis for local dev — unlike apps/api's rate
# limiter, this queue doesn't fail open; no jobs run without it.
REDIS_URL=redis://localhost:6379

# Must be the exact same value as apps/api/.env's GITHUB_TOKEN_KEY —
# this process decrypts what that one encrypts. Generate with:
#   openssl rand -hex 32
GITHUB_TOKEN_KEY=generate-your-own-with-openssl-rand-hex-32
