# Raptor — environment configuration template.
# Copy to .env and fill in real values for non-Docker local development.
# Never commit the real .env file. Inside Docker Compose, most of this is
# supplied via service `environment:` blocks and secrets/ files instead —
# see docker-compose.yml and secrets/*.txt.example.

# --- General ---
NODE_ENV=development

# --- API ---
API_PORT=4000
# DATABASE_URL is constructed automatically at container startup from
# secrets/postgres_password.txt (see apps/api/src/config/load-secrets.ts).
# Set it here directly only for non-Docker local dev against a Postgres
# you're running yourself.
# DATABASE_URL=postgresql://raptor:raptor@localhost:5432/raptor
# REDIS_URL=redis://localhost:6379

# --- Web ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- TEST_MODE ---
# TEST_MODE=false
# NEVER enable in production — writes email verification tokens to logs
# when true. Only for local development or the acceptance suite.
# See docs/stages/01-auth-and-email-setup.md Section 5. Exactly one call
# site in the codebase should ever check this flag.
