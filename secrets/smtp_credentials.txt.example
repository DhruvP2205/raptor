# Plain SMTP credentials — provider-agnostic (see Section 4.1 of
# docs/stages/01-auth-and-email-setup.md). Works with any SMTP-speaking
# provider: a self-hosted mail server, your organization's mail relay, or
# a consumer provider's SMTP relay.
#
# Copy this file to smtp_credentials.txt (gitignored) and fill in real
# values. One KEY=VALUE pair per line.
HOST=smtp.example.com
PORT=587
USER=your-smtp-username
PASSWORD=your-smtp-password
FROM=Raptor <noreply@example.com>
