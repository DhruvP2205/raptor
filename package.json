{
  "name": "raptor",
  "private": true,
  "version": "0.1.0",
  "description": "Raptor — a self-hostable, open-source hackathon submission & judging platform.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "pnpm --filter @raptor/api dev",
    "dev:web": "pnpm --filter @raptor/web dev",
    "build": "pnpm -r build",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  }
}
